# Copy this file to .env to change settings. START-LANDMINE.bat does it for you.
# Everything is optional. The basic player works with all of this commented out.

# Optional DJ: get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# PORT=3000

# If yt-dlp.exe is in this folder, the Windows launcher sets this for you.
# YTDLP_PATH=C:\path\to\yt-dlp.exe

# By default LANDMINE gives yt-dlp the Node running the server.
# YTDLP_JS_RUNTIME=off
# YTDLP_JS_RUNTIME=deno

# For tracks that need a signed-in YouTube session, choose one of these:
# YTDLP_COOKIES_FROM_BROWSER=firefox
# YTDLP_COOKIES_FILE=C:\path\to\cookies.txt

# If yt-dlp says its challenge solver is missing:
# YTDLP_REMOTE_COMPONENTS=ejs:github

# Any other yt-dlp flags, space separated:
# YTDLP_EXTRA_ARGS=

# Where downloads live and how many are kept:
# CACHE_DIR=C:\path\to\landmine-cache
# CACHE_MAX_TRACKS=80
